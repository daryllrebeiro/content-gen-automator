{
  "name": "content-gen-automator",
  "version": "0.3.0",
  "private": true,
  "description": "Agentic Cinema: ContentGenAutomator Studio Core",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "bash scripts/start_frontend.sh",
    "start": "npm run start --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "pip install -r backend/requirements.txt",
    "install:all": "npm run install:backend && npm run install:frontend",
    "backend": "bash scripts/start_backend.sh",
    "frontend": "bash scripts/start_frontend.sh"
  }
}
