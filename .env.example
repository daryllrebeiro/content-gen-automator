APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://short_agent:short_agent@localhost:5432/short_agent
PROJECT_REPOSITORY=memory
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=30
GEMINI_FACT_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:3000
INTEGRATION_SERVICE_TOKEN=
EXPORT_SIGNING_SECRET=change-me-in-production

# ── Partner Track Integrations ──
# IBM watsonx.governance (Primary Submitted Track)
IBM_WATSONX_API_KEY=
IBM_PROJECT_ID=
IBM_WATSONX_ENDPOINT=https://api.watsonx.ibm.com/v1/governance/evaluate

# Parallel Search API (Fact Grounding & Research)
PARALLEL_API_KEY=

# ClickHouse Cloud (High-Performance Analytics Store)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Grafana Labs Cloud (Observability & SLO Telemetry)
GRAFANA_OTLP_TOKEN=
